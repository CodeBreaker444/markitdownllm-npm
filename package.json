{
  "name": "markitdownllm",
  "version": "0.1.1",
  "description": "Browser-native document-to-Markdown converter for LLM pipelines. Converts PDF, DOCX, XLSX, PPTX, HTML, CSV, EPUB and more — entirely client-side, no server required.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "logo.svg"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "keywords": [
    "markdown",
    "pdf",
    "docx",
    "xlsx",
    "pptx",
    "llm",
    "document-converter",
    "browser",
    "wasm",
    "ai",
    "rag"
  ],
  "author": "CodeBreaker444",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codebreaker444/markitdownllm-npm.git"
  },
  "homepage": "https://markitdownllm.com",
  "peerDependencies": {
    "pdfjs-dist": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "pdfjs-dist": {
      "optional": true
    }
  },
  "dependencies": {
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "jszip": "^3.10.1",
    "mammoth": "^1.8.0",
    "turndown": "^7.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/turndown": "^5.0.5",
    "@vitest/coverage-v8": "^3.2.4",
    "happy-dom": "^17.4.7",
    "pdfjs-dist": "^6.0.227",
    "tsup": "^8.5.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "directories": {
    "test": "tests"
  },
  "bugs": {
    "url": "https://github.com/codebreaker444/markitdownllm/issues"
  }
}
